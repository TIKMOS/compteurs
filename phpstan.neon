includes:
    - vendor/larastan/larastan/extension.neon

# Niveau 5 retenu (décision du 2026-11-10), lancé par `composer lint` et par la CI. ENF-14
# (docs/CONCEPTION.md) vise le niveau 8 : le code y passe aussi sans erreur (commit 437b1e4),
# mais ce niveau n'est plus exigé.
parameters:
    level: 5
    paths:
        - app/
        - config/
        - database/
        - routes/
    excludePaths:
        - app/Modules/*/Tests/*
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # Ces traits sont utilisés par les composants Livewire monofichiers de
        # resources/views/livewire (classes anonymes dans des vues Blade), que PHPStan n'analyse pas.
        -
            identifier: trait.unused
            path: app/Modules/Metering/Livewire/Concerns/*
