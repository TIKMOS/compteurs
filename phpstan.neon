includes:
    - vendor/larastan/larastan/extension.neon

# Niveau 8 exigé par ENF-14 (docs/CONCEPTION.md), lancé par `composer lint` et par la CI.
parameters:
    level: 8
    paths:
        - app/
        - config/
        - database/
        - routes/
    excludePaths:
        - app/Modules/*/Tests/*
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # Ces traits sont utilisés par les composants Livewire monofichiers de
        # resources/views/livewire (classes anonymes dans des vues Blade), que PHPStan n'analyse pas.
        -
            identifier: trait.unused
            path: app/Modules/Metering/Livewire/Concerns/*
