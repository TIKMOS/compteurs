# =============================================================================
# Modèle de configuration de PRODUCTION (Hostinger). Copier en .env sur le serveur,
# puis remplir les valeurs « à remplir ». Voir README, section « Mise en production ».
# Ne jamais commiter le vrai .env.
# =============================================================================
APP_NAME=Compteurs
APP_ENV=production
# php artisan key:generate --show, une seule fois (changer la clé déconnecte tout le monde
# et invalide les liens WhatsApp déjà envoyés).
APP_KEY=
APP_DEBUG=false
APP_URL=https://compteurs.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Porto-Novo
APP_CURRENCY=XOF

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux : un fichier par jour, 14 jours gardés, avertissements et erreurs seulement.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL créée dans hPanel (Bases de données → MySQL).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sessions : cookie envoyé uniquement en HTTPS, inaccessible au JavaScript.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=compteurs-

# Emails (vérification d'adresse, mot de passe oublié, rappel de relevés) : SMTP Hostinger.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
